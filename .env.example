# Copy to .env (gitignored) and fill in. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local LLM (LM Studio) — ats/classify.py's escalation tier for postings the
# regex classifier can't confidently resolve (llm_local.py). Requires LM
# Studio running locally with the model below loaded.
LOCAL_LLM_URL=http://localhost:1234/v1/chat/completions
LOCAL_MODEL=google/gemma-4-e4b
LOCAL_LLM_TIMEOUT=120
# Cap on NEW (not-yet-cached) escalations per process run. Real registries can
# have thousands of postings with ~50% needing escalation at ~30-60s/call, so
# this bounds any single run; classify_cache.db persists results across runs
# so the backlog drains over several weekly runs instead of blocking one.
LLM_ESCALATION_CAP=250

# EPO Open Patent Services (free OAuth app: https://developers.epo.org/)
EPO_OPS_KEY=
EPO_OPS_SECRET=

# Google BigQuery patents (alt to EPO). Service-account JSON + project id.
# https://console.cloud.google.com/  -> enable BigQuery API -> create SA key
GOOGLE_APPLICATION_CREDENTIALS=
BQ_PROJECT=
